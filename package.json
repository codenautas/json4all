{
  "name": "json4all",
  "description": "JSON for all purposes and all environments",
  "version": "1.4.7",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": "codenautas/json4all",
  "license": "MIT",
  "main": "json4all.js",
  "types": "json4all.d.ts",
  "files": [
    "json4all.js",
    "json4all.d.ts"
  ],
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "best-globals": "^2.2.3",
    "discrepances": "^0.3.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "expect.js": "^0.3.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "qa-control": "^0.15.0",
    "require-bro": "^0.4.2",
    "server4test": "^2.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">= 22"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "scripts": {
    "build": "tsc -p test/ts",
    "test1": "mocha --reporter spec --bail --recursive --check-leaks test/**/test.js",
    "test": "mocha --reporter spec --bail --recursive --check-leaks test/**/test*.js",
    "test-nc": "mocha --reporter spec --bail --check-leaks --no-colors test/",
    "test-ci": "nyc --silent mocha --reporter spec --check-leaks test/**/test*.js && npm run test-navigator && nyc report",
    "test-cov": "nyc mocha --reporter dot --recursive --check-leaks test/**/test*.js",
    "test-nyc": "nyc npm run test",
    "build-test": "nyc instrument --delete json4all.js local-instrumented",
    "test-navigator": "npm run build-test && server4test --run-browser chrome,firefox",
    "test-navigator-inf": "npm run build-test && server4test",
    "report": "nyc report"
  },
  "qa-control": {
    "coverage": 99,
    "run-in": "both",
    "type": "lib",
    "gha": "all"
  }
}
